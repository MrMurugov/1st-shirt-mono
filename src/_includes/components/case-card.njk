{% set caseHref = ('/cases/#case-' ~ case.slug) | url %}
<article class="case-card"{% if caseArchive %} id="case-{{ case.slug }}"{% endif %}>
  {% if caseArchive %}
    <div class="case-card__media">
  {% else %}
    <a class="case-card__media" href="{{ caseHref }}" aria-label="Докладніше про кейс: {{ case.title }}">
  {% endif %}
    <img class="case-card__image" src="{{ case.image | url }}" alt="{{ case.title }}" loading="lazy" width="960" height="720">
    <span class="case-card__quantity">{{ case.quantity }} одиниць</span>
  {% if caseArchive %}</div>{% else %}</a>{% endif %}
  <div class="case-card__body">
    <p class="case-card__client"><span class="case-card__index" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>{{ case.client }}</p>
    {% if caseArchive %}
      <h2 class="case-card__title">{{ case.title }}</h2>
    {% else %}
      <h3 class="case-card__title"><a href="{{ caseHref }}">{{ case.title }}</a></h3>
    {% endif %}
    <p class="case-card__result">{{ case.result }}</p>
    <dl class="case-card__meta">
      <div><dt>Тираж</dt><dd>{{ case.quantity }} шт.</dd></div>
      <div><dt>Строк</dt><dd>{{ case.leadTime }}</dd></div>
    </dl>
    {% if caseArchive %}
      <dl class="case-card__brief">
        <div><dt>Задача</dt><dd>{{ case.challenge }}</dd></div>
        <div><dt>Рішення</dt><dd>{{ case.solution }}</dd></div>
      </dl>
    {% endif %}
  </div>
</article>
