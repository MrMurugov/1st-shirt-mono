<footer class="site-footer" id="contact">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand brand--footer" href="{{ '/' | url }}" aria-label="{{ site.name }} — на головну">
        <span class="brand__mark" aria-hidden="true">F/B</span>
        <span class="brand__name">Forma Bureau</span>
      </a>
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <p class="site-footer__description">{{ site.description }}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Розділи сайту">
      <h2 class="site-footer__title">Навігація</h2>
      <ul class="site-footer__links">
        <li><a href="{{ '/catalog/' | url }}">Каталог</a></li>
        <li><a href="{{ '/printing/' | url }}">Види нанесення</a></li>
        <li><a href="{{ '/solutions/' | url }}">Рішення для команд</a></li>
        <li><a href="{{ '/cases/' | url }}">Наші роботи</a></li>
        <li><a href="{{ '/about/' | url }}">Про виробництво</a></li>
        <li><a href="{{ '/contacts/' | url }}">Контакти</a></li>
      </ul>
    </nav>

    <div class="site-footer__contacts">
      <h2 class="site-footer__title">{{ site.contact.label }}</h2>
      <address class="site-footer__address">
        <a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
        <span>{{ site.contact.address }}</span>
        <span>{{ site.contact.hours }}</span>
      </address>
    </div>

    <div class="site-footer__action">
      <h2 class="site-footer__title">Є задача для команди?</h2>
      <p>Опишіть тираж — повернемося з варіантами текстилю та нанесення.</p>
      <a class="button button--light" href="{{ '/quote/' | url }}" data-quote-open data-modal-open="quote">Розрахувати тираж</a>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© 2026 {{ site.name }}. Концепт для презентації.</p>
    <p>{{ site.demoNotice }}</p>
    <ul class="site-footer__socials" aria-label="Соціальні мережі">
      {% for social in site.socials %}
        <li>
          {% if social.isDemo %}
            <span class="site-footer__social-placeholder" title="Посилання буде додано після запуску">{{ social.name }}</span>
          {% else %}
            <a href="{{ social.url }}">{{ social.name }}</a>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</footer>
