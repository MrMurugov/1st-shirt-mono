<div class="topbar" role="note">
  <div class="container topbar__inner">
    <p class="topbar__notice"><span aria-hidden="true">●</span> B2B-одяг для команд від {{ site.minimumOrder }} шт.</p>
    <p class="topbar__contact">Попередній розрахунок — 1 робочий день</p>
  </div>
</div>

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }} — на головну">
      <span class="brand__mark" aria-hidden="true">F/B</span>
      <span class="brand__name">Forma Bureau</span>
    </a>

    <nav class="site-nav site-nav--desktop" aria-label="Головна навігація">
      <ul class="site-nav__list">
        {% for item in site.navigation %}
          <li class="site-nav__item">
            <a
              class="site-nav__link"
              href="{{ item.url | url }}"
              {% if navKey and navKey == item.key %}aria-current="page"{% endif %}
            >{{ item.label }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-navigation"
      aria-haspopup="dialog"
      aria-label="Відкрити меню"
      data-menu-toggle
    >
      <span class="menu-toggle__icon" aria-hidden="true">
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
      </span>
      <span class="menu-toggle__label" data-menu-toggle-label>Меню</span>
    </button>

    <a
      class="button button--dark site-header__cta"
      href="{{ '/quote/' | url }}"
      data-quote-open
      data-modal-open="quote"
      {% if navKey == "quote" %}aria-current="page"{% endif %}
    >Розрахувати тираж</a>
  </div>
</header>

<dialog
  class="mobile-menu"
  id="mobile-navigation"
  aria-labelledby="mobile-navigation-title"
  aria-describedby="mobile-navigation-description"
  data-mobile-menu
>
  <div class="mobile-menu__shell" data-mobile-menu-shell>
    <div class="mobile-menu__scroll">
      <div class="mobile-menu__intro">
        <p class="eyebrow eyebrow--light" id="mobile-navigation-title">Навігація</p>
        <p id="mobile-navigation-description">Одяг і брендування для команд від {{ site.minimumOrder }} одиниць</p>
      </div>

      <nav class="mobile-nav" aria-label="Мобільна навігація">
        <ol class="mobile-nav__list">
          {% for item in site.navigation %}
            <li class="mobile-nav__item">
              <a
                class="mobile-nav__link"
                href="{{ item.url | url }}"
                {% if navKey and navKey == item.key %}aria-current="page"{% endif %}
              >
                <span class="mobile-nav__index" aria-hidden="true">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
                <span>{{ item.label }}</span>
                <span class="mobile-nav__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          {% endfor %}
        </ol>
      </nav>
    </div>

    <div class="mobile-menu__footer">
      <a
        class="button button--accent mobile-menu__cta"
        href="{{ '/quote/' | url }}"
        data-quote-open
        data-modal-open="quote"
        {% if navKey == "quote" %}aria-current="page"{% endif %}
      >Розрахувати тираж</a>
      <div class="mobile-menu__contacts">
        <a href="tel:{{ site.contact.phoneHref }}">{{ site.contact.phone }}</a>
        <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a>
      </div>
    </div>
  </div>
</dialog>
