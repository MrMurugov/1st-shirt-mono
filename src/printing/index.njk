---
layout: layouts/base.njk
title: Види нанесення на одяг — FORMA BUREAU
description: Шовкодрук, DTF, вишивка, сублімація та термотрансфер для корпоративного одягу.
bodyClass: printing-page
navKey: printing
---

{% from "components/page-intro.njk" import pageIntro %}
{% from "components/page-cta.njk" import pageCta %}
{{ pageIntro(
  "printing-title",
  "Види нанесення",
  "Технології",
  "Нанесення, яке відповідає задачі",
  "Обираємо технологію за матеріалом виробу, деталізацією макета, тиражем і умовами використання.",
  "Перед запуском погоджуємо розмір, позицію та колір нанесення."
) }}

<section class="section printing-methods" aria-label="Способи нанесення">
  <div class="container printing-methods__list">
    {% for method in printMethods %}
      <article class="printing-method" id="{{ method.slug }}">
        <div class="printing-method__media">
          <img src="{{ method.image | url }}" alt="{{ method.imageAlt or method.name }}" loading="lazy" width="960" height="720">
          <span class="printing-method__number" aria-hidden="true">0{{ loop.index }}</span>
        </div>
        <div class="printing-method__body">
          <p class="eyebrow">від {{ method.minOrder }} шт. · {{ method.leadTime }}</p>
          <h2>{{ method.name }}</h2>
          <p class="printing-method__tagline">{{ method.tagline }}</p>
          <p>{{ method.description }}</p>
          <dl class="printing-method__facts">
            <div><dt>Найкраще для</dt><dd>{{ method.bestFor }}</dd></div>
            <div><dt>Варто врахувати</dt><dd>{{ method.limitations }}</dd></div>
          </dl>
          <ul class="check-list">{% for advantage in method.advantages %}<li>{{ advantage }}</li>{% endfor %}</ul>
          <a
            class="text-link"
            href="{{ ('/quote/?method=' ~ method.id) | url }}"
            data-quote-open
            data-modal-open="quote"
            data-method-id="{{ method.id }}"
            data-method-name="{{ method.name }}"
          >Розрахувати цим методом <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

<section class="section section--tint method-comparison" aria-labelledby="comparison-title">
  <div class="container">
    <header class="section-heading section-heading--split"><div><p class="eyebrow">Швидке порівняння</p><h2 class="section-heading__title" id="comparison-title">Який спосіб обрати?</h2></div><p class="section-heading__aside">Це базова орієнтація. Точну рекомендацію дамо після перевірки макета й тканини.</p></header>
    <div class="table-wrap">
      <table class="comparison-table">
        <colgroup>
          <col class="comparison-table__technology">
          <col class="comparison-table__minimum">
          <col class="comparison-table__lead-time">
          <col class="comparison-table__application">
        </colgroup>
        <thead><tr><th scope="col">Технологія</th><th scope="col">Мін. тираж</th><th scope="col">Строк</th><th scope="col">Основне застосування</th></tr></thead>
        <tbody>{% for method in printMethods %}<tr><th scope="row">{{ method.shortName }}</th><td>від {{ method.minOrder }} шт.</td><td>{{ method.leadTime }}</td><td>{{ method.bestFor }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
  </div>
</section>

{{ pageCta(
  "printing-cta-title",
  "Є логотип або макет?",
  "Перевіримо й запропонуємо технологію",
  "Додайте файл до заявки — повернемося з рекомендацією та попереднім кошторисом."
) }}
