---
layout: layouts/base.njk
title: FORMA BUREAU — брендований одяг для бізнесу
description: Виробництво брендованого одягу для команд, закладів і подій від 20 одиниць.
bodyClass: home-page
navKey: home
---

<section class="hero hero--full-bleed" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow">{{ site.hero.eyebrow }}</p>
      <h1 class="hero__title" id="hero-title">
        <span>Одяг для команд,</span>
        <span class="hero__title-accent">який хочеться носити.</span>
      </h1>
      <p class="hero__text">{{ site.hero.text }}</p>
      <div class="hero__actions">
        <a class="button button--accent" href="{{ '/quote/' | url }}" data-quote-open data-modal-open="quote">{{ site.hero.primaryAction.label }}</a>
        <a class="button button--outline-light" href="{{ site.hero.secondaryAction.url | url }}">{{ site.hero.secondaryAction.label }} <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero__note"><span aria-hidden="true">●</span> {{ site.hero.note }}</p>
    </div>

    <figure class="hero__visual">
      <div class="hero__media">
        <img
          class="hero__image"
          src="{{ '/assets/images/hero/hero-production-v3.webp' | url }}"
          alt="Двоє фахівців перевіряють якість синього світшота у текстильній майстерні"
          width="1254"
          height="1254"
          fetchpriority="high"
          decoding="async"
        >
        <span class="hero__overlay" aria-hidden="true"></span>
        <span class="hero__image-label"><span aria-hidden="true">●</span> Контроль якості / 001</span>
      </div>
      <aside class="hero__aside" aria-label="Ключові умови">
        <p class="hero__aside-value">{{ site.minimumOrder }}+</p>
        <p class="hero__aside-label">одиниць у B2B-тиражі</p>
        <span class="hero__aside-line" aria-hidden="true"></span>
        <p>Текстиль · нанесення · пакування</p>
      </aside>
      <figcaption class="hero__caption"><span>Власна production-команда</span><span>Київ · Україна</span></figcaption>
    </figure>
  </div>
</section>

<section class="advantages" aria-label="Переваги роботи з нами">
  <div class="container advantages__grid">
    {% for advantage in site.advantages %}
      <article class="advantage">
        <span class="advantage__number" aria-hidden="true">0{{ loop.index }}</span>
        <h2 class="advantage__title">{{ advantage.title }}</h2>
        <p class="advantage__text">{{ advantage.text }}</p>
      </article>
    {% endfor %}
  </div>
</section>

<section class="section category-showcase" aria-labelledby="category-title">
  <div class="container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">01 / Каталог основ</p>
        <h2 class="section-heading__title" id="category-title">Почніть не з логотипа. Почніть із правильної основи.</h2>
      </div>
      <div class="section-heading__aside">
        <p>Від базових футболок до функціонального спецодягу. Порівнюйте посадку, щільність і ціну — не лише картинку.</p>
        <a class="text-link" href="{{ '/catalog/' | url }}">Увесь каталог <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="category-mosaic category-mosaic--home">
      {% for category in categories | selectattr("featured") %}
        {% if loop.index <= 6 %}
          <div class="category-mosaic__item category-mosaic__item--{{ loop.index }}">
            {% include "components/category-card.njk" %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tint featured-products" aria-labelledby="featured-products-title">
  <div class="container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">02 / Вибір команд</p>
        <h2 class="section-heading__title" id="featured-products-title">Речі, що витримують робочий ритм</h2>
      </div>
      <p class="section-heading__aside">Ціни орієнтовні й указані за чистий виріб. Фінальна вартість залежить від тиражу та нанесення.</p>
    </header>

    <div class="product-grid product-grid--featured">
      {% for product in products | selectattr("featured") %}
        {% if loop.index <= 4 %}{% include "components/product-card.njk" %}{% endif %}
      {% endfor %}
    </div>

    <div class="section__action">
      <a class="button button--dark" href="{{ '/catalog/' | url }}">Переглянути всі 18 моделей</a>
    </div>
  </div>
</section>

<section class="section solutions" id="solutions" aria-labelledby="solutions-title">
  <div class="container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">03 / За сценарієм</p>
        <h2 class="section-heading__title" id="solutions-title">Мерч, форма й одяг для зміни — це різні задачі</h2>
      </div>
      <div class="section-heading__aside">
        <p>Підбираємо тканину, посадку й спосіб нанесення під сценарій використання, а не лише під картинку.</p>
        <a class="text-link" href="{{ '/solutions/' | url }}">Усі рішення <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="solution-grid solution-grid--home">
      {% for solution in solutions | selectattr("featured") %}
        {% if loop.index <= 3 %}{% include "components/solution-card.njk" %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--dark print-showcase" id="print-methods" aria-labelledby="print-title">
  <div class="container">
    <header class="section-heading section-heading--split section-heading--light">
      <div>
        <p class="eyebrow eyebrow--light">04 / Друк і вишивка</p>
        <h2 class="section-heading__title" id="print-title">Технологія має працювати, а не просто виглядати</h2>
      </div>
      <div class="section-heading__aside">
        <p>Враховуємо деталізацію логотипа, навантаження на одяг, бюджет і бажану тактильність.</p>
        <a class="text-link text-link--light" href="{{ '/printing/' | url }}">Порівняти всі технології <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="print-grid">
      {% for method in printMethods %}
        {% if method.featured %}
          <article class="print-card">
            <img class="print-card__image" src="{{ method.image | url }}" alt="{{ method.imageAlt or method.name }}" loading="lazy" width="880" height="660">
            <div class="print-card__body">
              <div class="print-card__topline"><span>0{{ loop.index }}</span><span>від {{ method.minOrder }} шт.</span></div>
              <h3 class="print-card__title">{{ method.name }}</h3>
              <p class="print-card__tagline">{{ method.tagline }}</p>
              <p class="print-card__best"><strong>Найкраще для:</strong> {{ method.bestFor }}</p>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section cases-showcase" id="cases" aria-labelledby="cases-title">
  <div class="container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">05 / Кейси</p>
        <h2 class="section-heading__title" id="cases-title">Рішення видно в деталях</h2>
      </div>
      <div class="section-heading__aside">
        <p>Демонстраційні кейси показують, як ми будуємо рішення для різних команд і сценаріїв.</p>
        <a class="text-link" href="{{ '/cases/' | url }}">Усі кейси <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="case-grid case-grid--home">
      {% for case in cases | selectattr("featured") %}
        {% if loop.index <= 3 %}{% include "components/case-card.njk" %}{% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--tint production" id="production" aria-labelledby="production-title">
  <div class="container">
    <header class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">06 / Процес</p>
        <h2 class="section-heading__title" id="production-title">П’ять контрольних точок. Жодної магії.</h2>
      </div>
      <p class="section-heading__aside">На кожному етапі є погоджений результат: специфікація, макет, сигнальний зразок або готовий комплект.</p>
    </header>

    <ol class="process-list">
      {% for item in site.process %}
        <li class="process-card">
          <span class="process-card__step">{{ item.step }}</span>
          <h3 class="process-card__title">{{ item.title }}</h3>
          <p class="process-card__text">{{ item.text }}</p>
        </li>
      {% endfor %}
    </ol>

    <div class="stats" aria-label="Показники виробництва">
      {% for stat in site.stats %}
        <div class="stat"><strong class="stat__value">{{ stat.value }}</strong><span class="stat__label">{{ stat.label }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq__layout">
    <header class="section-heading faq__heading">
      <p class="eyebrow">07 / Без дрібного шрифту</p>
      <h2 class="section-heading__title" id="faq-title">Що варто знати до замовлення</h2>
      <p>Не знайшли відповіді? Опишіть задачу — уточнимо технологію, строк і бюджет.</p>
      <a class="text-link" href="{{ '/contacts/' | url }}">Поставити запитання <span aria-hidden="true">↗</span></a>
    </header>
    <div class="accordion" data-accordion>
      {% for item in faq %}
        {% if loop.index <= 7 %}
          <details class="accordion__item"{% if loop.first %} open{% endif %}>
            <summary class="accordion__summary"><span>{{ item.question }}</span><span class="accordion__icon" aria-hidden="true">+</span></summary>
            <div class="accordion__content"><p>{{ item.answer }}</p></div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section quote-section" id="quote" aria-labelledby="quote-title">
  <div class="container quote-section__layout">
    <div class="quote-section__intro">
      <p class="eyebrow">08 / Старт</p>
      <h2 class="quote-section__title" id="quote-title">{{ site.quoteForm.title }}</h2>
      <p class="quote-section__text">{{ site.quoteForm.text }}</p>
      <ul class="quote-section__promises">
        <li>Відповідь протягом одного робочого дня</li>
        <li>2–3 варіанти під ваш бюджет</li>
        <li>Фіксація строків до запуску</li>
      </ul>
    </div>
    <div class="quote-section__form">
      {% include "components/quote-form.njk" %}
    </div>
  </div>
</section>
